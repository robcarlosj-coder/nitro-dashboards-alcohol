# ─────────────────────────────────────────────────────────────
#  Nitro · Painel de Consumo Global de Álcool
#  Copie para .env e preencha. O .env NÃO vai para o Git.
#  Em produção, cadastre as mesmas variáveis em
#  Vercel › Project › Settings › Environment Variables.
# ─────────────────────────────────────────────────────────────

# Google Gemini — usado por /api/chat
GEMINI_API_KEY=

# Cadeia de fallback de modelos, em ordem de preferência (opcional).
# Se ausente, vale o padrão embutido em api/chat.js.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash,gemini-flash-latest

# OpenWeatherMap — usado por /api/weather
OPENWEATHER_API_KEY=
